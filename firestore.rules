rules_version = '2';

// ─────────────────────────────────────────────────────────────────────────────
// DinePulse — Complete Firestore Security Rules
// Covers: restaurants, menu (categories/items), tables & QR, orders,
//         feedback, payments, waiters/staff portal + shift logs,
//         hotel partners (V4Stay integration key flow)
//
// Publish: Firebase Console → Firestore Database → Rules → paste → Publish
// ─────────────────────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Restaurants ────────────────────────────────────────────────────────
    // Restaurant doc id == owner's Auth uid.
    // Public read: guests scan QR menu, staff enter restaurant ID.
    // Only the owner can create/update their restaurant (signup, settings, plan).
    match /restaurants/{rid} {
      allow read: if true;
      allow create, update, delete:
        if request.auth != null && request.auth.uid == rid;

      // ── Orders ────────────────────────────────────────────────────────────
      // Guests place orders (no auth), waiters claim them, kitchen updates
      // status, owner reads analytics. Anyone with the restaurant ID can
      // interact — same trust level the guest ordering flow already uses.
      match /orders/{oid} {
        allow read, write: if true;
      }

      // ── Hotel Partners (V4Stay integration) ────────────────────────────────
      // Hotel managers create a partnership request ONLY with the restaurant's
      // current Integration Key. The V4Stay hotel client must include:
      //   integrationKey: <key pasted by hotel admin>, status: 'pending'
      // and must READ its request status with a constrained query:
      //   where('integrationKey', '==', key)
      // Owner (auth.uid == rid) approves / revokes / deletes.
      // A hotel can never self-approve: status is forced to 'pending' on create
      // and updates are owner-only.
      match /hotelPartners/{partnerId} {
        allow create: if
          request.resource.data.status == 'pending' &&
          request.resource.data.integrationKey ==
            get(/databases/$(database)/documents/restaurants/$(rid)).data.integrationKey;
        allow update, delete:
          if request.auth != null && request.auth.uid == rid;
        allow read:
          if request.auth != null && request.auth.uid == rid ||
             resource.data.integrationKey ==
               get(/databases/$(database)/documents/restaurants/$(rid)).data.integrationKey;
      }

      // ── Menu: categories + nested items ───────────────────────────────────
      match /categories/{cid} {
        allow read: if true;
        allow create, update, delete:
          if request.auth != null && request.auth.uid == rid;

        match /items/{iid} {
          allow read: if true;
          allow create, update, delete:
            if request.auth != null && request.auth.uid == rid;
        }
      }

      // ── Tables & QR codes ─────────────────────────────────────────────────
      match /tables/{tid} {
        allow read: if true;
        allow create, update, delete:
          if request.auth != null && request.auth.uid == rid;
      }

      // ── Waiters / Staff portal ────────────────────────────────────────────
      // read     : waiter portal loads the waiter list (to pick own name)
      // create   : only the owner (manager adds waiters)
      // delete   : only the owner (manager removes waiters)
      // update   : waiter device (clock in/out, 30s heartbeat, pickup counter)
      //            — but the waiter name and personal PIN are IMMUTABLE for
      //            unauthenticated devices: identity changes only via the
      //            manager (delete + re-add). Prevents anyone with the
      //            restaurant ID from rewriting a waiter's credentials.
      match /staff/{sid} {
        allow read: if true;
        allow create, delete:
          if request.auth != null && request.auth.uid == rid;
        allow update:
          if request.resource.data.name == resource.data.name &&
             request.resource.data.pin == resource.data.pin;

        // ── Shift logs (manager-maintained duty records) ────────────────────
        // One doc per duty shift: startedAt, endedAt, onlineSeconds,
        // ordersPicked. Waiter device creates/ends its own shift; manager
        // may close shifts that were never clocked out.
        match /shifts/{shiftId} {
          allow read, write: if true;
        }
      }

      // ── Feedback ──────────────────────────────────────────────────────────
      // Guests submit; only the owner reads the ratings.
      match /feedback/{fid} {
        allow create: if true;
        allow read: if request.auth != null && request.auth.uid == rid;
        allow update, delete:
          if request.auth != null && request.auth.uid == rid;
      }

      // ── Payments (plan upgrades) ──────────────────────────────────────────
      match /payments/{pid} {
        allow read, write:
          if request.auth != null && request.auth.uid == rid;
      }
    }
  }
}
